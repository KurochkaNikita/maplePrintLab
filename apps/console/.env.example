# Console app (apps/console). Copy to .env.local and fill in.
# Required in the Vercel project (Production and Preview): NEON_AUTH_BASE_URL, NEON_AUTH_COOKIE_SECRET, DATABASE_URL.

# Neon Auth (Neon console -> Auth). "Auth URL" without a trailing slash.
NEON_AUTH_BASE_URL=
# Random secret for session cookies, 32+ chars: `openssl rand -base64 32`.
NEON_AUTH_COOKIE_SECRET=

# Neon Postgres connection string with WRITE access (pooled connection).
# Required in the Vercel project too: the console reads `neon_auth.account."isAdmin"`
# to decide who may sign in. The packages/db scripts (drizzle-kit, db:seed,
# db:check, db:verify) also load it from this file.
DATABASE_URL=

# Origin of the public site (same value as the public project), no trailing slash.
# Used to show product photos in the product list; without it a placeholder is shown.
# Locally: http://localhost:3000
NEXT_PUBLIC_SITE_URL=

# Vercel Blob store for product photos (Vercel project -> Storage -> Blob). Without it uploads fail.
# Locally: `vercel env pull apps/console/.env.local` after creating the store.
BLOB_READ_WRITE_TOKEN=

# Secret for the daily Blob cleanup cron (/api/cron/blob-cleanup); Vercel sends it as a Bearer token.
# Required in the Vercel project (Production): `openssl rand -base64 32`. Without it the endpoint answers 401.
# Dry run locally: curl -H "Authorization: Bearer $CRON_SECRET" "https://localhost:3001/api/cron/blob-cleanup?dryRun=1"
CRON_SECRET=

# Deploy Hook of the PUBLIC Vercel project (Settings -> Git -> Deploy Hooks). The "Publish" button posts to it
# to rebuild the static site from the database. Secret: set it in the console project only.
SITE_DEPLOY_HOOK_URL=
