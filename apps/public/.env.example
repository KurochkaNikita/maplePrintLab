# Public site (root app). Copy to .env.local and fill in.

# Main domain, no trailing slash. Used for canonical/hreflang/sitemap.
NEXT_PUBLIC_SITE_URL=https://mapleprintlab.store

# Neon Postgres connection string, read-only role. Needed at BUILD time only.
# Neon console -> Connection details -> pooled connection.
DATABASE_URL=

# Origin of the console app (admin), no trailing slash. The request page posts to <this>/api/order-request.
# Production: https://admin.mapleprintlab.store   Local: https://localhost:3001
# Without it the "Add to request" button stays a link to /contact/. The console must allow this site's origin
# (NEXT_PUBLIC_SITE_URL, or PUBLIC_SITE_ORIGIN for local/preview) in CORS.
NEXT_PUBLIC_CONSOLE_URL=

# Cloudflare Turnstile SITE key (public). Empty = no widget (only accepted by a console without TURNSTILE_SECRET_KEY in dev).
# Local testing: 1x00000000000000000000AA always passes.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
