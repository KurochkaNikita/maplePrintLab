# Admin app (apps/admin). Copy to .env.local and fill in.

# Neon Postgres connection string with WRITE access (pooled connection).
DATABASE_URL=

# Auth.js: random secret, generate with `openssl rand -base64 32`.
AUTH_SECRET=
# Public URL of the admin app (http://localhost:3001 locally, https://admin.mapleprintlab.store in prod).
AUTH_URL=http://localhost:3001

# Single admin account.
ADMIN_USERNAME=
# bcrypt hash of the admin password. In .env files escape every "$" as "\$".
ADMIN_PASSWORD_HASH=

# Vercel Blob read/write token for product photos
# (Vercel -> Storage -> Blob -> create store -> .env.local tab).
BLOB_READ_WRITE_TOKEN=

# Vercel Deploy Hook URL of the PUBLIC SITE project (Settings -> Git -> Deploy Hooks).
# Called by the "Publish" button.
SITE_DEPLOY_HOOK_URL=

# Main site URL, for "view on site" links.
NEXT_PUBLIC_SITE_URL=https://mapleprintlab.store
