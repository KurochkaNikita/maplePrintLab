{
  "manifest_version": 3,
  "name": "Maple Print Lab: Marketplace filler",
  "description": "Fills the Facebook Marketplace listing form from a product in the Maple Print Lab admin. You press Publish yourself.",
  "version": "0.1.0",
  "background": {
    "service_worker": "background.js"
  },
  "externally_connectable": {
    "matches": [
      "https://admin.mapleprintlab.store/*",
      "http://localhost/*",
      "https://localhost/*"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.facebook.com/marketplace/create/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://*.public.blob.vercel-storage.com/*",
    "https://mapleprintlab.store/*"
  ],
  "permissions": [
    "storage"
  ],
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Maple Print Lab: Marketplace filler",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  }
}
