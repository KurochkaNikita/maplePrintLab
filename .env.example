# Public site (root app). Copy to .env.local and fill in.

# Main domain, no trailing slash. Used for canonical/hreflang/sitemap.
NEXT_PUBLIC_SITE_URL=https://mapleprintlab.store

# Neon Postgres connection string, read-only role. Needed at BUILD time only.
# Neon console -> Connection details -> pooled connection.
DATABASE_URL=
