{
  "name": "maple-print-lab",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k \"yarn dev:public\" \"yarn dev:console\"",
    "dev:public": "yarn workspace @maple-print-lab/public dev",
    "dev:console": "yarn workspace @maple-print-lab/console dev",
    "build": "yarn build:public && yarn build:console",
    "build:public": "yarn workspace @maple-print-lab/public build",
    "build:console": "yarn workspace @maple-print-lab/console build",
    "typecheck": "yarn workspaces run typecheck"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
